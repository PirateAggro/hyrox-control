# Copia aquest fitxer a `.env.local` i omple els valors del projecte Hyrox
# (Supabase → Project Settings → API). `.env.local` no es puja al git.

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
# Clau pública (anon / publishable). Malgrat el prefix NEXT_PUBLIC_, només la
# fa servir el servidor: el navegador no parla mai amb Supabase.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clau de servei (service_role / secret). Només per al servidor; encara no
# es fa servir (fase 4: correu i manteniment del projecte actiu).
SUPABASE_SERVICE_ROLE_KEY=
