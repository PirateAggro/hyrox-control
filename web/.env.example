# Desenvolupament local: copia aquest fitxer a `web/.env.local` i omple els
# valors del projecte Hyrox (Supabase → Project Settings → API Keys).
# `.env.local` no es puja al git. Per a la Pi, vegeu `../.env.example`.

SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
# Clau pública (sb_publishable_... o anon).
SUPABASE_ANON_KEY=
# Clau secreta (sb_secret_... o service_role). Encara no es fa servir.
SUPABASE_SERVICE_ROLE_KEY=
