# Claus per a la Raspberry Pi. Copia aquest fitxer a `.env` (a l'arrel de la
# carpeta hyrox-control de la Pi) i omple-hi els valors del projecte Hyrox
# (Supabase → Project Settings → API Keys). `.env` no es puja mai al git.
#
# Els noms no porten NEXT_PUBLIC_ a propòsit: així es llegeixen en arrencar i
# no queden gravats dins la imatge de Docker.

SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
# Clau pública (sb_publishable_... o anon).
SUPABASE_ANON_KEY=
# Clau secreta (sb_secret_... o service_role). Encara no es fa servir.
SUPABASE_SERVICE_ROLE_KEY=
